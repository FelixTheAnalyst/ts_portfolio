dq = dq, n_oos = sum(ok),
g_fwd_txt = fmt_p(g_fwd), g_rev_txt = fmt_p(g_rev),
size_txt = scales::percent(power_df$power[1]),
mde_txt = ifelse(is.na(mde), "not reached", sprintf("%.2f × ω", mde))),
"results/p1_results.rds")
# Benchmark regressor: lagged 8-week mean realised variance, scaled to [0, 1]
